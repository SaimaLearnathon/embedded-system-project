{
  "configurations": [
    {
      "name": "JLink: Debug Application",
      "cwd": "${workspaceFolder}/app",
      "executable": "./firmware.elf",
      "servertype": "openocd",
      "request": "launch",
      "type": "cortex-debug",
      "device": "STM32F103C8",
      "runToEntryPoint": "main",
      "interface": "swd",
      "configFiles": ["interface/stlink.cfg", "target/stm32f1x.cfg"],
      "preLaunchTask": "build_debug"
    },
    {
      "name": "JLink: Attach to Application",
      "cwd": "${workspaceFolder}/app",
      "executable": "./firmware.elf",
      "servertype": "openocd",
      "request": "attach",
      "type": "cortex-debug",
      "device": "STM32F103C8",
      "runToEntryPoint": "main",
      "interface": "swd",
      "configFiles": ["interface/stlink.cfg", "target/stm32f1x.cfg"]
    },
    {
