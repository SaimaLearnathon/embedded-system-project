{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "power_on",
      "command": "JLinkExe -CommandFile .vscode/jlink/power-on.jlink",
      "problemMatcher": []
    },
    {
      "type": "shell",
      "label": "power_off",
      "command": "JLinkExe -CommandFile .vscode/jlink/power-off.jlink",
      "problemMatcher": []
    },
    {
      "type": "shell",
      "label": "build_debug",
      "options": {
        "cwd": "app"
      },
      "command": "make bin",
      "problemMatcher": "$gcc"
    },
    {
      "type": "shell",
      "label": "build_debug_bootloader",
      "options": {
        "cwd": "bootloader"
      },
      "command": "make bin",
      "problemMatcher": "$gcc"
    },
    {
      "type": "shell",
      "label": "build_fw_updater",
      "options": {
        "cwd": "fw-updater"
      },
      "command": "npm run build",
      "problemMatcher": "$tsc"
    },
    {
      "type": "shell",
      "label": "flash_stlink",
      "options": {
        "cwd": "app"
      },
      "command": "make bin && st-flash write firmware.bin 0x08000000",
      "problemMatcher": []
    },
    {
      "type": "shell",
      "label": "flash_openocd",
      "options": {
        "cwd": "app"
      },
      "command": "make bin && openocd -f interface/stlink.cfg -f target/stm32f1x.cfg -c \"program firmware.bin verify reset exit 0x08000000\"",
      "problemMatcher": []
    }
  ]
}